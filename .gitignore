# Terraform state
*.tfstate
*.tfstate.*
**/.terraform/

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
tfplan

# Terraform variable files containing secrets
*.tfvars

# Keep example variable files
!terraform.tfvars.example

# Terraform lock file
# Keep this tracked for reproducible provider versions
# Do NOT ignore .terraform.lock.hcl

# Backend configuration containing environment-specific details
# Ignore actual backend files if they contain sensitive/private values
backend.hcl

# Keep backend examples
!backend.hcl.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets / credentials
*.pem
*.key
.env
.env.*
!.env.example

# AWS credentials
.aws/


# Environment example files - keep local only
dev/terraform.tfvars.example
dev/backend.hcl.example

stage/terraform.tfvars.example
stage/backend.hcl.example

prod/terraform.tfvars.example
prod/backend.hcl.example
